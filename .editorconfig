root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
charset = utf-8-bom
end_of_line = crlf
csharp_new_line_before_open_brace = all

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.{md,yml}]
charset = utf-8
end_of_line = lf

[*.yml]
indent_size = 2
